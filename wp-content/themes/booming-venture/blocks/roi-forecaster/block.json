{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "booming-venture/roi-forecaster",
  "version": "1.0.0",
  "title": "ROI Forecaster",
  "category": "booming-venture",
  "icon": "chart-line",
  "description": "Interactive ROI forecaster with cumulative revenue chart, table view, and PDF export. Self-contained ,  no external dependencies.",
  "keywords": ["roi", "forecast", "growth", "calculator"],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": { "margin": true, "padding": true }
  },
  "attributes": {
    "currency": { "type": "string", "default": "EUR" },
    "horizonMonths": { "type": "number", "default": 12 },
    "showPdfExport": { "type": "boolean", "default": true }
  },
  "textdomain": "booming-venture",
  "editorScript": "file:./editor.js",
  "viewScript": "file:./view.js",
  "style":  "file:./view.css",
  "render": "file:./render.php"
}
