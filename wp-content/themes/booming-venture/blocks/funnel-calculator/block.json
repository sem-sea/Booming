{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "booming-venture/funnel-calculator",
  "version": "1.0.0",
  "title": "Funnel Leak Calculator",
  "category": "booming-venture",
  "icon": "filter",
  "description": "Interactive funnel calculator that pinpoints where revenue is leaking and recommends fixes. Self-contained ,  no external dependencies.",
  "keywords": ["funnel", "calculator", "growth", "cro"],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": { "margin": true, "padding": true }
  },
  "attributes": {
    "currency": { "type": "string", "default": "EUR" },
    "defaultStage": { "type": "string", "default": "leads" },
    "showPdfExport": { "type": "boolean", "default": true }
  },
  "textdomain": "booming-venture",
  "editorScript": "file:./editor.js",
  "viewScript": "file:./view.js",
  "style":  "file:./view.css",
  "render": "file:./render.php"
}
