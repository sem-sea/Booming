{
  "name": "booming-venture-blocks",
  "version": "1.0.0",
  "private": true,
  "description": "Vite + @wordpress/scripts build pipeline for the custom Gutenberg blocks bundled with the Booming Venture theme.",
  "scripts": {
    "build:funnel": "wp-scripts build --webpack-src-dir=funnel-calculator/src --output-path=funnel-calculator/build",
    "build:roi":    "wp-scripts build --webpack-src-dir=roi-forecaster/src    --output-path=roi-forecaster/build",
    "build":        "npm run build:funnel && npm run build:roi",
    "start:funnel": "wp-scripts start --webpack-src-dir=funnel-calculator/src --output-path=funnel-calculator/build",
    "start:roi":    "wp-scripts start --webpack-src-dir=roi-forecaster/src    --output-path=roi-forecaster/build",
    "lint":         "wp-scripts lint-js funnel-calculator/src roi-forecaster/src"
  },
  "dependencies": {
    "@wordpress/blocks":        "^14.0.0",
    "@wordpress/block-editor":  "^14.0.0",
    "@wordpress/components":    "^29.0.0",
    "@wordpress/i18n":          "^5.0.0",
    "framer-motion":            "^12.6.5",
    "html2canvas":              "^1.4.1",
    "jspdf":                    "^3.0.1",
    "lucide-react":             "^0.462.0",
    "react":                    "^18.3.1",
    "react-dom":                "^18.3.1",
    "react-hook-form":          "^7.53.0",
    "recharts":                 "^2.12.7",
    "zod":                      "^3.23.8"
  },
  "devDependencies": {
    "@types/react":     "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@wordpress/scripts": "^30.0.0",
    "typescript":       "^5.5.3"
  }
}
