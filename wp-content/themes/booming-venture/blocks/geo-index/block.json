{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "booming-venture/geo-index",
  "version": "1.0.0",
  "title": "B2B GEO Index",
  "category": "booming-venture",
  "icon": "chart-bar",
  "description": "Monthly measured GEO readiness of 200 B2B companies, with filters, sorting and a domain check. Server-rendered, so crawlers read the full ranking.",
  "keywords": ["geo", "ranking", "ai search", "index"],
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "spacing": { "margin": true, "padding": true }
  },
  "attributes": {
    "list": { "type": "string", "default": "" }
  },
  "textdomain": "booming-venture",
  "editorScript": "file:./editor.js",
  "viewScript": "file:./view.js",
  "style": "file:./view.css",
  "render": "file:./render.php"
}
